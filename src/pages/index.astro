---
import Layout from '../layouts/Layout.astro';
import WelcomeScreen from '../components/WelcomeScreen.astro';
import MemoryGallery from '../components/MemoryGallery.astro';
import MiniGamesZone from '../components/MiniGamesZone.astro';
import InteractiveLetter from '../components/InteractiveLetter.astro';
import GrandFinale from '../components/GrandFinale.astro';
import VinylPlayer from '../components/VinylPlayer.astro';
---

<Layout title="Feliz mes amor ❤️ | 1 Año y 11 Meses">
	<main class="relative w-full min-h-screen">
		<!-- Partículas de fondo -->
		<div class="fixed inset-0 pointer-events-none opacity-20 bg-[radial-gradient(ellipse_at_center,_var(--color-love-purple)_0%,_var(--color-love-dark)_100%)]"></div>

		<WelcomeScreen />
		
		<div id="hidden-content" class="hidden opacity-0 transition-opacity duration-1000">
			<MemoryGallery />
			<MiniGamesZone />
			<InteractiveLetter />
			<GrandFinale />
			<VinylPlayer />
		</div>
	</main>
</Layout>
