---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Una sorpresa especial para celebrar 1 año y 11 meses llenos de amor." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&family=Fira+Code:wght@300..700&family=Inter:wght@100..900&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[var(--color-love-dark)] text-white font-body selection:bg-[var(--color-love-pink)] selection:text-white">
		
		<slot />

		<!-- Overlay del Easter Egg -->
		<div id="easter-overlay" class="fixed inset-0 z-[999] bg-black/0 pointer-events-none flex items-center justify-center transition-all duration-700 opacity-0">
			<div id="easter-card" class="relative glass border border-pink-400 rounded-3xl p-8 max-w-sm w-full mx-4 text-center scale-50 transition-all duration-700 shadow-[0_0_80px_rgba(247,37,133,0.8)]">
				<div class="text-6xl mb-4 animate-bounce">💖</div>
				<h2 class="font-display text-4xl text-pink-300 mb-3">¡Te amo!</h2>
				<p class="text-white text-lg mb-2">¡Encontraste el secreto mágico!</p>
				<p class="text-pink-200 text-sm">Así de grande es mi amor por ti... infinito e irrompible. ✨</p>
				<div id="easter-hearts" class="absolute inset-0 pointer-events-none overflow-hidden rounded-3xl"></div>
			</div>
		</div>

		<script>
			// Easter Egg Global
			const pass = "teamo";
			let secretCode = "";

			function triggerEasterEgg() {
				const overlay = document.getElementById('easter-overlay')!;
				const card = document.getElementById('easter-card')!;
				const heartsContainer = document.getElementById('easter-hearts')!;

				overlay.style.pointerEvents = 'auto';
				overlay.style.backgroundColor = 'rgba(0,0,0,0.85)';
				overlay.style.opacity = '1';
				card.style.transform = 'scale(1)';

				// Crear corazones flotantes
				for (let i = 0; i < 20; i++) {
					setTimeout(() => {
						const h = document.createElement('div');
						h.innerText = ['💖','💗','💕','❤️','💓'][Math.floor(Math.random()*5)];
						h.style.cssText = `position:absolute;font-size:${Math.random()*20+15}px;left:${Math.random()*100}%;bottom:-10%;animation:riseHeart ${Math.random()*2+2}s ease-in forwards;`;
						heartsContainer.appendChild(h);
						setTimeout(() => h.remove(), 4000);
					}, i * 150);
				}

				// Cerrar al tocar en 5 segundos o antes
				overlay.addEventListener('click', () => {
					overlay.style.opacity = '0';
					card.style.transform = 'scale(0.5)';
					setTimeout(() => {
						overlay.style.pointerEvents = 'none';
						overlay.style.backgroundColor = 'rgba(0,0,0,0)';
						secretCode = "";
					}, 700);
				}, { once: true });
			}

			// Detectar en teclado físico (computadoras)
			window.addEventListener("keydown", (e) => {
				secretCode += e.key.toLowerCase();
				if (secretCode.length > pass.length) secretCode = secretCode.slice(1);
				if (secretCode === pass) triggerEasterEgg();
			});

			// Exponer función globalmente para el input móvil
			(window as any).checkEasterInput = (val: string) => {
				if (val.toLowerCase().includes(pass)) triggerEasterEgg();
			};
		</script>

		<style>
			@keyframes riseHeart {
				0% { transform: translateY(0) scale(1); opacity: 1; }
				100% { transform: translateY(-300px) scale(0.3); opacity: 0; }
			}
		</style>
	</body>
</html>
