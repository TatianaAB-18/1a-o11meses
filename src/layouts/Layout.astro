---
import '../styles/global.css';

interface Props {
	title: string;
}

const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="description" content="Una sorpresa especial para celebrar 1 año y 11 meses llenos de amor." />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>

		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400..700&family=Fira+Code:wght@300..700&family=Inter:wght@100..900&display=swap" rel="stylesheet">
	</head>
	<body class="bg-[var(--color-love-dark)] text-white font-body selection:bg-[var(--color-love-pink)] selection:text-white">
		
		<slot />

		<script>
			// Easter Egg Global: Teclado "teamo"
			let secretCode = "";
			const pass = "teamo";

			window.addEventListener("keydown", (e) => {
				secretCode += e.key.toLowerCase();
				if (secretCode.length > pass.length) {
					secretCode = secretCode.slice(1);
				}
				if (secretCode === pass) {
					alert("💖 ¡Encontraste el Easter Egg! ¡Te amo muchísimo! 💖");
					// Aquí podemos poner más animaciones especiales
				}
			});
		</script>
	</body>
</html>
